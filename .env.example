# Nodeseek credentials
NODESEEK_USERNAME=your_username
NODESEEK_PASSWORD=your_password

# Attendance settings
# Check-in time in HH:MM format (24h)
ATTENDANCE_TIME=09:00
# Random delay in seconds, added before check-in (0 to disable)
RANDOM_DELAY_MAX=0
# Attendance mode: "fixed" (5 chicken legs) or "random" (try your luck)
ATTENDANCE_MODE=fixed

# Login settings
# Headless mode for browser (true/false)
HEADLESS=true
# Browser timeout in milliseconds (increase if Turnstile is slow)
LOGIN_TIMEOUT=120000
# Number of login attempts before giving up
LOGIN_RETRIES=2

# Runtime state directory for cookies.json and signer.log
# Local default: project directory; Docker image default: /data
# DATA_DIR=/data

# Docker Compose image override
# NS_SIGNER_IMAGE=ghcr.io/<owner>/<repo>:latest
