# Nodeseek credentials
NODESEEK_USERNAME=your_username
NODESEEK_PASSWORD=your_password

# Attendance settings
# Check-in time in HH:MM format (24h)
ATTENDANCE_TIME=09:00
# Random delay in seconds, added before check-in (0 to disable)
RANDOM_DELAY_MAX=0
# Attendance mode: "fixed" (5 chicken legs) or "random" (try your luck)
ATTENDANCE_MODE=fixed
# A check-in that missed its slot is still worth having, so a failed one is
# retried on this interval until it lands or the window below runs out.
ATTENDANCE_RETRY_MINUTES=20
ATTENDANCE_RETRY_HOURS=20

# Session settings
# Logging in is the fragile part of the day, so it is done at a quiet hour rather
# than during the midnight check-in rush, and days before the session runs out.
SESSION_CHECK_TIME=13:20
SESSION_RENEW_DAYS=7

# Login settings
# Headless mode for browser (true/false). The image has no display, so "false"
# only works with one provided from outside.
HEADLESS=true
# Browser timeout in milliseconds (increase if Turnstile is slow)
LOGIN_TIMEOUT=120000
# Login attempts before giving up. Turnstile stalls on a fair share of page loads
# and only a fresh browser can retry it, so leave room for several attempts.
LOGIN_RETRIES=15
# Let Scrapling run its Cloudflare challenge solver before the page is used.
SOLVE_CLOUDFLARE=true
# Keep the browser profile between runs (true/false). A returning browser carries
# the cf_clearance it earned last time, which Cloudflare treats far better than a
# brand-new one.
BROWSER_PROFILE=true
# BROWSER_PROFILE_DIR=/data/browser-profile

# Mailbox settings (optional)
# NodeSeek will not let a device it has never seen in on a password alone -- it
# mails a code instead. Point these at a mailbox and the tool can read that code
# and finish the login by itself; leave them empty and it can only report the
# refusal. IMAP_USERNAME defaults to EMAIL_ADDRESS, which itself defaults to
# NODESEEK_USERNAME when that is an address.
# EMAIL_ADDRESS=you@example.com
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USERNAME=you@example.com
# IMAP_PASSWORD=your_app_password
# IMAP_MAILBOX=INBOX
# IMAP_SSL=true
# EMAIL_CODE_TIMEOUT=180

# Runtime state directory for session.json and signer.log
# Local default: project directory; Docker image default: /data
# DATA_DIR=/data

# Docker Compose image override
# NS_SIGNER_IMAGE=ghcr.io/<owner>/<repo>:latest
